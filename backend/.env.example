# ======================
# Application Settings
# ======================
APP_NAME=MedSight AI Backend
APP_VERSION=1.0.0
DEBUG=False

# ======================
# Server Settings
# ======================
HOST=0.0.0.0
PORT=8000

# ======================
# Database - PostgreSQL (Neon)
# ======================
# Format: postgresql+psycopg2://username:password@host:5432/database?sslmode=require
# Example: postgresql+psycopg2://user:pass@ep-xxx.us-east-2.aws.neon.tech:5432/medsight_db?sslmode=require
DATABASE_URL=postgresql+psycopg2://your_username:your_password@your_neon_host:5432/your_database?sslmode=require
DB_ECHO=False

# ======================
# AWS S3 Configuration
# ======================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-medsight-bucket
S3_PATIENTS_PREFIX=patients/
S3_CASES_PREFIX=cases/
S3_ORIGINAL_IMAGES_PREFIX=original/
S3_PROCESSED_IMAGES_PREFIX=processed/
S3_ANNOTATED_IMAGES_PREFIX=annotated/
S3_SEGMENTATION_PREFIX=segmentation/
S3_REPORTS_PREFIX=reports/
S3_EDUCATION_PREFIX=education/
S3_STUDENT_UPLOADS_PREFIX=student_uploads/
S3_STUDENT_ANNOTATIONS_PREFIX=student_annotations/
S3_FEEDBACK_PREFIX=feedback/
S3_SIMILAR_CASES_PREFIX=similar_cases/
S3_THUMBNAILS_PREFIX=thumbnails/
S3_TEMP_PREFIX=temp/uploads/
S3_EXPORTS_PREFIX=exports/

# ======================
# Zilliz Cloud Vector Database
# For local Milvus REST, set ZILLIZ_CLOUD_URI to your Milvus endpoint
# (commonly http://localhost:19530) and leave ZILLIZ_CLOUD_API_KEY empty
# ======================
ZILLIZ_CLOUD_URI=https://your-zilliz-endpoint.api.gcp-us-west1.zillizcloud.com
ZILLIZ_CLOUD_API_KEY=your_zilliz_api_key
ZILLIZ_COLLECTION_NAME=med_vector
ZILLIZ_TXT_DIMENSION=1152
ZILLIZ_IMG_DIMENSION=1152

# ======================
# CORS Settings
# ======================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ======================
# Security
# ======================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# CORS
# ======================
# JSON list format, for example:
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ======================
# AI Model Paths
# ======================
MODEL_INFERENCE_PATH=../MedSightAI
MEDGEMMA_PATH=../medgemma
VINDR_DATASET_PATH=../VindrDataset

# ======================
# File Upload Settings
# ======================
MAX_UPLOAD_SIZE=10485760

# ======================
# Model Inference Service
# ======================
MODEL_INFERENCE_URL=http://localhost:8001
